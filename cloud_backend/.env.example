# 组织共享服务配置示例；从 cloud_backend 目录手动运行时使用。
# 数据库与受管对象目录需要一起备份；正式部署使用明确的绝对路径。
DATABASE_URL=sqlite:///./cloud_dev.db
STORAGE_DIR=./cloud_storage
# 未提交上传暂存独立限制为 6 GiB / 1000 份，保留 24 小时供失败重试。
# 仅在后续上传时清理过期暂存；不会删除 objects 中的已发布对象。
STAGING_MAX_BYTES=6442450944
STAGING_MAX_UPLOADS=1000
STAGING_TTL_SECONDS=86400
# 替换为随机密钥；账号通过 provision_mvp.py 开通，不提供默认管理员。
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# 桌面/网页共用，单进程每 60 秒账号 10 次、IP 60 次；多 worker 需外层全局限流。
LOGIN_ACCOUNT_ATTEMPTS=10
LOGIN_IP_ATTEMPTS=60
LOGIN_WINDOW_SECONDS=60
LOGIN_BUCKET_LIMIT=10000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=9000
