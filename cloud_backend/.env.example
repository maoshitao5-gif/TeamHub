# 数据库（开发用 SQLite，生产用 PostgreSQL）
DATABASE_URL=sqlite:///./cloud_dev.db
# DATABASE_URL=postgresql://user:password@localhost:5432/teamhub_cloud

# JWT 配置（生产环境必须替换为随机字符串，最少 32 位）
JWT_SECRET_KEY=dev-secret-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OSS 存储（兼容 MinIO 本地 + 阿里云 OSS 生产）
OSS_ENDPOINT=http://localhost:9001
OSS_ACCESS_KEY_ID=minioadmin
OSS_ACCESS_KEY_SECRET=minioadmin
OSS_BUCKET_NAME=teamhub-dev
OSS_PREFIX=teamhub-cloud
# 生产阿里云 OSS 示例（endpoint 不带 http://，设置 use_ssl=true）：
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 服务端口
PORT=9000
