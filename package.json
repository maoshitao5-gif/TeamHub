{
  "name": "teamhub-desktop",
  "version": "1.0.0",
  "description": "TeamHub 团队文件管理系统 - 桌面版",
  "main": "electron/main.js",
  "author": "TeamHub Team",
  "license": "MIT",
  "scripts": {
  "electron:dev": "concurrently \"npm run frontend:dev\" \"node start-electron-delay.js\"",
  "electron:build": "npm run frontend:build && electron-builder",
  "frontend:dev": "cd frontend && npm run dev",
  "frontend:build": "cd frontend && npm run build",
  "backend:build": "pyinstaller teamhub-backend.spec",
  "build:all": "npm run backend:build && npm run frontend:build && npm run electron:build",
  "start": "electron ."
},
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "build": {
    "appId": "com.teamhub.desktop",
    "productName": "TeamHub",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "!frontend/src",
      "!frontend/node_modules",
      "!frontend/public",
      "!backend",
      "!**/*.py",
      "!**/*.pyc",
      "!**/__pycache__"
    ],
    "extraResources": [
      {
        "from": "dist/teamhub-backend.exe",
        "to": "backend/teamhub-backend.exe",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "dist/teamhub-backend",
          "to": "backend/teamhub-backend"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "extraResources": [
        {
          "from": "dist/teamhub-backend",
          "to": "backend/teamhub-backend"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeamHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
