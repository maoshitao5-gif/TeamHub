{
  "name": "teamhub-desktop",
  "version": "1.0.0",
  "description": "TeamHub 团队文件管理系统 - 桌面版",
  "main": "electron/main.js",
  "author": "TeamHub Team",
  "license": "MIT",
  "scripts": {
    "dev": "bash scripts/mvp-dev.sh start",
    "dev:browser": "bash scripts/mvp-dev.sh start-all",
    "dev:api": "bash scripts/mvp-dev.sh start",
    "electron:dev": "node start-electron-delay.js",
    "electron:build": "npm run backend:build && npm run hermes:build && npm run frontend:build && electron-builder",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:build": "node scripts/build-backend.cjs",
    "hermes:build": "node scripts/build-hermes.cjs",
    "launcher:build": "node scripts/build-desktop-launcher.cjs",
    "accounts:build": "node scripts/build-desktop-launcher.cjs accounts",
    "build:all": "npm run electron:build",
    "start": "node start-electron-delay.js",
    "dev:stop": "bash scripts/mvp-dev.sh stop",
    "dev:status": "bash scripts/mvp-dev.sh status"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "com.teamhub.desktop",
    "productName": "TeamHub",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "!frontend/src",
      "!frontend/node_modules",
      "!frontend/public",
      "!backend",
      "!**/*.py",
      "!**/*.pyc",
      "!**/__pycache__"
    ],
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend"
      },
      {
        "from": "dist/hermes",
        "to": "hermes"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TeamHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
