# 团队文件管理系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ========== 必需配置 ==========
# JWT 密钥（必须修改！使用强随机字符串）
# 可以使用以下命令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-PLEASE-GENERATE-A-RANDOM-STRING

# ========== 可选配置 ==========
# 数据库连接字符串
# SQLite (默认):
DATABASE_URL=sqlite:///./teamhub.db
# PostgreSQL 示例:
# DATABASE_URL=postgresql://user:password@localhost/teamhub
# MySQL 示例:
# DATABASE_URL=mysql://user:password@localhost/teamhub

# 文件存储目录
STORAGE_DIR=storage

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/teamhub.log

# 默认管理员账号（仅首次运行时创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# 文件上传限制
MAX_FILE_SIZE=1073741824  # 1GB in bytes
# ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,txt,jpg,png  # 留空表示允许所有类型

# JWT Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30天
